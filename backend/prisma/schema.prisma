generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  DRIVER
  ADMIN
  BUSINESS
}

enum DriverStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum DriverOnlineStatus {
  ONLINE
  OFFLINE
  ON_TRIP
}

enum RideStatus {
  SEARCHING
  ACCEPTED
  DRIVER_ARRIVING
  DRIVER_ARRIVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CLICK
  PAYME
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum TariffType {
  STANDARD
  COMFORT
  NIGHT
  INTERCITY
  WAITING
}

enum CourierStatus {
  PENDING
  ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
}

model User {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  phone         String   @unique
  password      String
  role          UserRole @default(PASSENGER)
  avatar        String?
  language      String   @default("uz")
  isVerified    Boolean  @default(false)
  isBlocked     Boolean  @default(false)
  fcmToken      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  driver           Driver?
  ridesAsPassenger Ride[]             @relation("PassengerRides")
  favoriteAddresses FavoriteAddress[]
  notifications    Notification[]
  reviewsGiven     Review[]           @relation("ReviewAuthor")
  reviewsReceived  Review[]           @relation("ReviewTarget")
  promoUsages      PromoCodeUsage[]
  courierOrders    CourierOrder[]
  complaints       Complaint[]

  @@index([phone])
}

model Driver {
  id              String             @id @default(cuid())
  userId          String             @unique
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          DriverStatus       @default(PENDING)
  onlineStatus    DriverOnlineStatus @default(OFFLINE)
  currentLat      Float?
  currentLng      Float?
  rating          Float              @default(5.0)
  totalRides      Int                @default(0)
  totalEarnings   Float              @default(0)
  balance         Float              @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  vehicle         Vehicle?
  documents       DriverDocument[]
  rides           Ride[]
  reviews         Review[]           @relation("DriverReviews")
}

model Vehicle {
  id          String   @id @default(cuid())
  driverId    String   @unique
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  brand       String
  model       String
  color       String
  plateNumber String   @unique
  year        Int?
  photo       String?
  createdAt   DateTime @default(now())
}

model DriverDocument {
  id         String   @id @default(cuid())
  driverId   String
  driver     Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  type       String
  fileUrl    String
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Ride {
  id              String        @id @default(cuid())
  passengerId     String
  passenger       User          @relation("PassengerRides", fields: [passengerId], references: [id])
  driverId        String?
  driver          Driver?       @relation(fields: [driverId], references: [id])
  status          RideStatus    @default(SEARCHING)
  fromAddress     String
  fromLat         Float
  fromLng         Float
  toAddress       String
  toLat           Float
  toLng           Float
  distance        Float
  duration        Int
  tariff          TariffType    @default(STANDARD)
  estimatedPrice  Float
  finalPrice      Float?
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PENDING)
  commission      Float         @default(0)
  promoCodeId     String?
  scheduledAt     DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  review   Review?
  payment  Payment?
  promoCode PromoCode? @relation(fields: [promoCodeId], references: [id])

  @@index([passengerId])
  @@index([driverId])
  @@index([status])
}

model Payment {
  id          String        @id @default(cuid())
  rideId      String        @unique
  ride        Ride          @relation(fields: [rideId], references: [id], onDelete: Cascade)
  amount      Float
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  transactionId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Tariff {
  id          String      @id @default(cuid())
  type        TariffType  @unique
  name        String
  basePrice   Float
  pricePerKm  Float
  pricePerMin Float       @default(0)
  minPrice    Float       @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Route {
  id          String   @id @default(cuid())
  fromCity    String
  toCity      String
  basePrice   Float
  distance    Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([fromCity, toCity])
}

model Review {
  id          String   @id @default(cuid())
  rideId      String   @unique
  ride        Ride     @relation(fields: [rideId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("ReviewAuthor", fields: [authorId], references: [id])
  targetId    String
  target      User     @relation("ReviewTarget", fields: [targetId], references: [id])
  driverId    String?
  driver      Driver?  @relation("DriverReviews", fields: [driverId], references: [id])
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  @@index([driverId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  @@index([userId])
}

model PromoCode {
  id         String    @id @default(cuid())
  code       String    @unique
  discount   Float
  type       String    @default("PERCENT")
  minAmount  Float     @default(0)
  maxUses    Int?
  usedCount  Int       @default(0)
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  rides      Ride[]
  usages     PromoCodeUsage[]
}

model PromoCodeUsage {
  id         String   @id @default(cuid())
  promoCodeId String
  promoCode  PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rideId     String?
  usedAt     DateTime @default(now())
}

model Business {
  id          String   @id @default(cuid())
  name        String
  category    String
  description String?
  address     String
  phone       String
  image       String?
  workHours   String?
  rating      Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CourierOrder {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  senderName    String
  senderPhone   String
  receiverName  String
  receiverPhone String
  fromAddress   String
  toAddress     String
  itemDesc      String
  price         Float
  status        CourierStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Complaint {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  rideId      String?
  subject     String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}

model FavoriteAddress {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  address   String
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
}

model AdminLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String
  details   Json?
  createdAt DateTime @default(now())
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}